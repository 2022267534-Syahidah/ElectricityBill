<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <!-- Header -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="5dp"
            app:cardBackgroundColor="@color/colorAccent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="20dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✏️ Edit Bill Record"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Edit Form Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="5dp"
            app:cardBackgroundColor="@color/colorSurface">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Month -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Month" android:textColor="@color/colorOnBackground"
                    android:textStyle="bold" android:textSize="14sp"/>
                <Spinner android:id="@+id/spinnerMonth"
                    android:layout_width="match_parent" android:layout_height="48dp"
                    android:layout_marginTop="6dp" android:layout_marginBottom="16dp"
                    android:background="@drawable/spinner_bg"
                    android:paddingStart="12dp" android:paddingEnd="12dp"/>

                <!-- Units -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Units Used (kWh)" android:textColor="@color/colorOnBackground"
                    android:textStyle="bold" android:textSize="14sp"/>
                <EditText android:id="@+id/editTextUnits"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:layout_marginBottom="16dp"
                    android:inputType="numberDecimal"
                    android:background="@drawable/edittext_bg"
                    android:padding="12dp"
                    android:hint="1 – 1000 kWh"
                    android:textSize="15sp"
                    android:textColor="@color/colorOnBackground"
                    android:textColorHint="@color/colorHint"/>

                <!-- Rebate SeekBar -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Rebate (%)" android:textColor="@color/colorOnBackground"
                    android:textStyle="bold" android:textSize="14sp"/>
                <TextView android:id="@+id/tvRebateValue"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Rebate: 0%" android:textColor="@color/colorPrimary"
                    android:textStyle="bold" android:gravity="center"
                    android:layout_marginTop="6dp"/>
                <SeekBar android:id="@+id/seekBarRebate"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:max="5" android:progress="0"
                    android:progressTint="@color/colorPrimary"
                    android:thumbTint="@color/colorPrimary"
                    android:layout_marginBottom="20dp"/>

                <!-- Error TextView -->
                <TextView android:id="@+id/tvError"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="" android:textColor="@color/colorError"
                    android:textSize="13sp" android:visibility="gone"
                    android:layout_marginBottom="12dp"/>

                <!-- Buttons -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUpdate"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="UPDATE RECORD"
                    android:textStyle="bold"
                    android:backgroundTint="@color/colorPrimary"
                    android:layout_marginBottom="8dp"
                    app:cornerRadius="12dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancel"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="CANCEL"
                    android:textStyle="bold"
                    android:backgroundTint="@color/colorPrimaryDark"
                    app:cornerRadius="12dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
