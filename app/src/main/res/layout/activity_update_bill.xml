<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sky_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingTop="24dp">

        <!-- Notice -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/card_bg"
            android:padding="10dp"
            android:layout_marginBottom="14dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✎ "
                android:textColor="@color/sky_primary"
                android:textSize="13sp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Edit the fields below and tap Save Changes."
                android:textColor="@color/sky_primary"
                android:textSize="12sp"/>
        </LinearLayout>

        <!-- Edit card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EDIT RECORD"
                android:textSize="10sp"
                android:textColor="@color/sky_primary"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:paddingBottom="14dp"/>

            <!-- Month (fixed) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Month (cannot be changed)"
                android:textColor="@color/text_label"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingBottom="6dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/input_bg"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/textViewUpdateMonth"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="—"
                    android:textColor="@color/sky_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔒"
                    android:textSize="14sp"/>
            </LinearLayout>

            <!-- Units -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Units Used (kWh)"
                android:textColor="@color/text_label"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingBottom="6dp"/>

            <EditText
                android:id="@+id/editTextUpdateUnits"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/input_bg"
                android:inputType="number"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginBottom="6dp"/>

            <!-- Units error -->
            <TextView
                android:id="@+id/tvUpdateError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⚠ Units must be between 1 and 1000 kWh"
                android:textColor="@color/colorError"
                android:textSize="11sp"
                android:background="@drawable/error_bg"
                android:padding="7dp"
                android:layout_marginBottom="12dp"
                android:visibility="gone"/>

            <!-- Rebate -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="4dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Rebate (0% – 5%)"
                    android:textColor="@color/text_label"
                    android:textSize="12sp"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/textViewUpdateRebateVal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textColor="@color/sky_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <SeekBar
                android:id="@+id/seekBarUpdateRebate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="5"
                android:progressTint="@color/sky_primary"
                android:thumbTint="@color/sky_primary"
                android:layout_marginBottom="4dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="0%" android:textColor="@color/text_hint" android:textSize="10sp"/>
                <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="5%" android:textColor="@color/text_hint" android:textSize="10sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Save button -->
        <Button
            android:id="@+id/buttonUpdate"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="SAVE CHANGES"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="14sp"
            android:backgroundTint="@color/sky_primary"
            android:layout_marginBottom="10dp"/>

        <!-- Cancel button -->
        <Button
            android:id="@+id/buttonUpdateBack"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="CANCEL"
            android:textColor="@color/sky_primary"
            android:textStyle="bold"
            android:textSize="14sp"
            android:backgroundTint="@color/white"/>

    </LinearLayout>
</ScrollView>
