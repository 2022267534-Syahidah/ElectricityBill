<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sky_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Record Info Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_result_bg"
            android:padding="16dp"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="12dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Calculation Result"
                    android:textSize="15sp"
                    android:textColor="@color/sky_primary"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- Month -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:paddingBottom="8dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Month:"
                    android:textColor="@color/text_secondary" android:textSize="13sp"/>
                <TextView android:id="@+id/tvDetailMonth"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="—" android:textColor="@color/text_primary"
                    android:textSize="13sp" android:textStyle="bold"/>
            </LinearLayout>

            <!-- Units -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:paddingBottom="8dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Units Used:"
                    android:textColor="@color/text_secondary" android:textSize="13sp"/>
                <TextView android:id="@+id/tvDetailUnits"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="—" android:textColor="@color/text_primary"
                    android:textSize="13sp" android:textStyle="bold"/>
            </LinearLayout>

            <!-- Total Charges -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:paddingBottom="8dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Total Charges:"
                    android:textColor="@color/text_secondary" android:textSize="13sp"/>
                <TextView android:id="@+id/tvDetailTotal"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="—" android:textColor="@color/text_primary"
                    android:textSize="13sp" android:textStyle="bold"/>
            </LinearLayout>

            <!-- Rebate -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:paddingBottom="12dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Rebate:"
                    android:textColor="@color/text_secondary" android:textSize="13sp"/>
                <TextView android:id="@+id/tvDetailRebate"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="—" android:textColor="@color/aqua_accent"
                    android:textSize="13sp" android:textStyle="bold"/>
            </LinearLayout>

            <!-- Divider -->
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/sky_divider" android:layout_marginBottom="12dp"/>

            <!-- Final Cost -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Final Cost:"
                    android:textColor="@color/sky_primary" android:textSize="14sp"
                    android:textStyle="bold"/>
                <TextView android:id="@+id/tvDetailFinal"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="—" android:textColor="@color/sky_primary"
                    android:textSize="22sp" android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Block breakdown card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="14dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PRICE BREAKDOWN"
                android:textSize="10sp"
                android:textColor="@color/sky_primary"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:paddingBottom="10dp"/>

            <LinearLayout android:id="@+id/layoutBlocks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/sky_divider" android:layout_marginTop="6dp" android:layout_marginBottom="6dp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Total Charges"
                    android:textColor="@color/sky_primary" android:textSize="13sp" android:textStyle="bold"/>
                <TextView android:id="@+id/tvBreakdownTotal"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="—" android:textColor="@color/sky_primary"
                    android:textSize="13sp" android:textStyle="bold" android:fontFamily="monospace"/>
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/buttonViewBack"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="BACK"
            android:textColor="@color/sky_primary"
            android:textStyle="bold"
            android:backgroundTint="@color/white"/>
    </LinearLayout>
</ScrollView>
